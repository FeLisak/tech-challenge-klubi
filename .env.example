# Provedor de IA usado só para interpretar buscas vagas ("algo econômico pra família").
# Serve qualquer API compatível com o endpoint de chat da OpenAI.
# Sem essas variáveis, a busca continua funcionando com o parser.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Opcional: JSON somado à requisição, para opções específicas do provedor.
# Ex.: {"thinking":{"type":"disabled"}} desliga o raciocínio em modelos que pensam antes de responder.
AI_REQUEST_OPTIONS=
