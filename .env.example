# Provedor de IA, usado só para interpretar buscas vagas ("algo econômico pra família").
# Opcional: sem ele, a busca funciona normalmente com o parser.
# Para ligar, preencha as três primeiras variáveis. Faltando qualquer uma, a IA fica desligada.
# Serve qualquer provedor com API compatível com o chat da OpenAI.

# Endpoint completo de chat, terminando em /chat/completions (não a raiz do provedor).
# Ex.: https://api.seu-provedor.com/v1/chat/completions
AI_API_URL=

# Chave de API do provedor. Fica só no servidor e nunca vai para o repositório.
AI_API_KEY=

# Nome do modelo, exatamente como o provedor lista em /models.
AI_MODEL=

# Opcional: JSON somado a cada requisição, para opções específicas do provedor.
# Ex.: {"thinking":{"type":"disabled"}} desliga o raciocínio de modelos que pensam antes de responder,
# o que deixa a resposta mais rápida e mais barata.
AI_REQUEST_OPTIONS=
